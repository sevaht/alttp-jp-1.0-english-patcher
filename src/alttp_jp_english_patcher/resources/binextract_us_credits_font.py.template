#!/usr/bin/env python3
"""
binextract-us-credits-font.py -- build a US-styled alternate for credits'
TOP/BOTTOM (2-tile, white) location-caption font, in the exact same
tile-slot layout as jp_credits_font.2bpp (see binextract-jp-credits-font.py),
from your own US ROM. Nothing copyrighted is committed to this repo; the
`binextract.py` stub runs this (alongside binextract-jp.py, binextract-us.py,
binextract-jp-credits-font.py, always AFTER binextract-jp-credits-font.py --
this script reads its output) to produce `bin/gfx/us_credits_font.2bpp`.

    python3 binextract-us-credits-font.py              # uses ./alttp-us.sfc
    python3 binextract-us-credits-font.py --us-rom US.sfc

You need the US ROM (md5 $us_rom_md5), by default named `alttp-us.sfc` in
this directory, AND bin/gfx/jp_credits_font.2bpp already built (binextract.py
guarantees the order; running this standalone out of order will fail loudly).

Credits has two fonts, not one, and only one of them is region-specific.
The SMALL (1-tile, yellow) captions use a bold font that's pixel-identical
between the JP and US ROMs -- nothing to swap, nothing built here. The
TOP/BOTTOM (2-tile, white) location captions are the genuinely
region-specific one: JP 1.0's own bolder glyphs vs. the US ROM's own
TheFont (its regular dialogue VWF font -- confirmed live, the real US ROM's
Credits_InitializeTheActualCredits calls TransferFontToVRAM directly for
credits, no separate compressed credits-only asset on the US side).

So the output here is NOT a font built from scratch: it starts as an exact
copy of the already-built jp_credits_font.2bpp (every slot, SMALL role
included, comes through unchanged), then overwrites only the TOP-role
slots TOP_TILE_MAP lists with the corresponding US TheFont tiles (both
halves -- TheFont's own letters are genuinely 16px/2-tile tall, tile N =
top half, tile N+16 = bottom half). Tile slots TOP_TILE_MAP doesn't list
are untouched JP data, not blank. Output is verified against a known md5;
the script stops loudly if it doesn't match.

GENERATED from alttp_jp_english_patcher/us_credits_font_asset.py -- do not
hand-edit; change that module and redeploy to regenerate this file.
"""
import argparse, hashlib, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "bin", "gfx")

US_ROM_MD5 = $us_rom_md5
OUTPUT_MD5 = $output_md5
JP_CREDITS_FONT_FILENAME = $jp_credits_font_filename

# US TheFont lives at this ROM offset (see us_assets.py's "us_font.2bpp"
# slice) -- read directly here rather than depending on that file already
# having been extracted, since extraction order between scripts isn't
# guaranteed for this one (unlike JP_CREDITS_FONT_FILENAME, see below).
US_FONT_OFFSET = $us_font_offset
US_FONT_SIZE = $us_font_size

# (JP credits TOP-role tile slot -> source US TheFont top-half tile) for
# every 2-tile location-caption character JP's credits actually reference,
# read directly off the real US Credits_CharacterToTile table (usdasm
# bank_0E) -- not a formula guess, the real game deviates from the formula
# for a few characters (digits, 'I'). TheFont's own letters are genuinely
# 16px (2 tiles) tall -- RenderText_PerformVWFing (usdasm bank_0E) draws a
# "top" tile at this number, then a "bottom" tile at tile+16 -- so both
# halves get copied verbatim: JP slot -> tile (top), JP slot+16 -> tile+16
# (bottom).
TOP_TILE_MAP = $top_tile_map


def md5(b):
    return hashlib.md5(b).hexdigest()


def die(msg):
    print("ERROR:", msg, file=sys.stderr)
    sys.exit(1)


def check_rom(path):
    if not path or not os.path.isfile(path):
        die(f"US ROM not found: {path!r}")
    got = md5(open(path, "rb").read())
    if got != US_ROM_MD5:
        die(
            f"US ROM md5 mismatch: got {got}, expected {US_ROM_MD5}\n"
            f"       (this must be the US release)"
        )
    print(f"  US ROM ok ({got})")


def build_output(us_rom_bytes, jp_credits_font_bytes):
    # Start from JP's own already-built credits font verbatim -- SMALL role
    # (and anything else TOP_TILE_MAP doesn't list) is untouched JP data,
    # not re-derived here.
    out = bytearray(jp_credits_font_bytes)
    # TheFont's own 4-value shading is preserved as-is -- the CGRAM palette
    # patch in generate.py's credits_font_upload (only when --credits-font
    # us) is what makes it render correctly, not any pixel-level change
    # here.
    font = us_rom_bytes[US_FONT_OFFSET : US_FONT_OFFSET + US_FONT_SIZE]
    for jp_slot, us_tile in TOP_TILE_MAP.items():
        for half in (0, 16):
            src = (us_tile + half) * 16
            dst = (jp_slot + half) * 16
            out[dst : dst + 16] = font[src : src + 16]
    return bytes(out)


def main():
    ap = argparse.ArgumentParser(
        description="build the US-styled credits font alternate from your"
        " own US ROM"
    )
    ap.add_argument(
        "--us-rom",
        default=os.path.join(HERE, "alttp-us.sfc"),
        help="US ROM (default: ./alttp-us.sfc)",
    )
    a = ap.parse_args()

    a.us_rom = os.path.abspath(a.us_rom)
    print("Validating ROM:")
    check_rom(a.us_rom)
    os.makedirs(OUT, exist_ok=True)

    jp_credits_font_path = os.path.join(OUT, JP_CREDITS_FONT_FILENAME)
    if not os.path.isfile(jp_credits_font_path):
        die(
            f"{JP_CREDITS_FONT_FILENAME} not found in {OUT} -- run"
            " binextract-jp-credits-font.py first (binextract.py does this"
            " automatically, in order)"
        )

    print("Building US-styled credits font:")
    us_rom_bytes = open(a.us_rom, "rb").read()
    jp_credits_font_bytes = open(jp_credits_font_path, "rb").read()
    data = build_output(us_rom_bytes, jp_credits_font_bytes)
    got = md5(data)
    out = os.path.join(OUT, "us_credits_font.2bpp")
    open(out, "wb").write(data)
    ok = got == OUTPUT_MD5
    status = "OK" if ok else "MD5 MISMATCH"
    print(f"  bin/gfx/us_credits_font.2bpp {got}  [{status}]")
    if not ok:
        die(
            "output did not match the expected md5.\n"
            "       Double-check that your US ROM matches the md5 at the"
            " top of this script."
        )
    print("\nUS-styled credits font built and verified.")


if __name__ == "__main__":
    main()
