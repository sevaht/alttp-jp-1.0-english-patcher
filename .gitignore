# Python / tooling caches (uv.lock is tracked, for reproducible dev tooling)
.venv/
build/
dist/
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ROMs and build artifacts must never live here.
*.sfc
*.srm
alttp.sfc
alttp-us.sfc

# Local convenience scripts (personal target paths, not part of the package).
patch-baseline.sh
patch-full.sh
start-script-reviewer.local.sh

# tools/: built binaries, downloaded emulator/core, capture artifacts (see
# tools/README.md). link_intro.srm is a deliberate test fixture, not a build
# artifact -- un-ignore it from the blanket *.srm rule above.
tools/runner
tools/libretro.h
tools/snes9x_libretro.so
tools/mesen/
tools/*.ppm
tools/*.png
tools/*.bin
!tools/link_intro.srm
# gba_script_diff.py output (ROM-derived copyrighted game text -- --out
# already refuses an in-repo path, this is belt-and-braces).
tools/*.html
tools/wording.txt
tools/full.txt
